<div class="custom-content section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading text-center">
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="custom-content__grid grid grid--1-col grid--{{ section.settings.columns_desktop }}-col-desktop">
      {%- for block in section.blocks -%}
        <div class="grid__item custom-content__item custom-content__item--{{ block.type }}" {{ block.shopify_attributes }}>
           {%- case block.type -%}
             {%- when 'image' -%}
                <div class="custom-content__image media media--{% if block.settings.image_aspect == 'square' %}square{% else %}adapt{% endif %}">
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 1500 | image_tag: loading: 'lazy' }}
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
             {%- when 'text' -%}
                <div class="custom-content__text-box text-{{ block.settings.align }}">
                  <h3 class="h2">{{ block.settings.title | escape }}</h3>
                  <div class="rte">{{ block.settings.text }}</div>
                  {%- if block.settings.button_label != blank -%}
                    <a href="{{ block.settings.link }}" class="button">{{ block.settings.button_label | escape }}</a>
                  {%- endif -%}
                </div>
             {%- when 'html' -%}
                <div class="custom-content__html">
                  {{ block.settings.html }}
                </div>
           {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .custom-content__item {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .custom-content__image {
    border-radius: 12px;
    overflow: hidden;
  }
  .custom-content__text-box {
    padding: 3rem;
    background: rgba(var(--color-base-text), 0.03);
    border-radius: 12px;
    height: 100%;
  }
  .custom-content__text-box h3 {
    margin-bottom: 2rem;
    font-weight: 800;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Custom content",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
       "type": "select",
       "id": "heading_size",
       "options": [
          { "value": "h2", "label": "Small" },
          { "value": "h1", "label": "Medium" },
          { "value": "h0", "label": "Large" }
       ],
       "default": "h1",
       "label": "Heading size"
    },
    {
       "type": "range",
       "id": "columns_desktop",
       "min": 1,
       "max": 4,
       "step": 1,
       "default": 2,
       "label": "Number of columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_aspect",
          "options": [
            { "value": "square", "label": "Square" },
            { "value": "adapt", "label": "Adapt to image" }
          ],
          "default": "adapt",
          "label": "Image aspect ratio"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Add a title",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Add custom text content.</p>",
          "label": "Text"
        },
        {
           "type": "text",
           "id": "button_label",
           "label": "Button label"
        },
        {
           "type": "url",
           "id": "link",
           "label": "Button link"
        },
        {
          "type": "select",
          "id": "align",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" }
          ],
          "default": "left",
          "label": "Alignment"
        }
      ]
    },
    {
      "type": "html",
      "name": "Custom HTML",
      "settings": [
        {
          "type": "html",
          "id": "html",
          "label": "HTML code"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom content",
      "blocks": [
        { "type": "text" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
