<div class="logo-list section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading text-center">
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="logo-list__wrapper">
       <div class="logo-list__grid">
          {%- for block in section.blocks -%}
            <div class="logo-list__item" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                 {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', class: 'logo-img' }}
              {%- else -%}
                 {{ 'image' | placeholder_svg_tag: 'placeholder-svg logo-placeholder' }}
              {%- endif -%}
            </div>
          {%- endfor -%}
       </div>
    </div>
  </div>
</div>

{%- style -%}
  .logo-list {
    background-color: var(--color-background);
    padding: 4rem 0;
  }
  .logo-list__grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 4rem;
  }
  .logo-list__item {
    width: 15rem;
    opacity: {{ section.settings.logo_opacity | divided_by: 100.0 }};
    transition: opacity 0.3s ease;
    filter: grayscale(1);
  }
  .logo-list__item:hover {
    opacity: 1;
    filter: grayscale(0);
  }
  .logo-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .logo-list__item { width: 10rem; gap: 2rem; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Logo list",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Trusted by leading brands",
      "label": "Heading"
    },
    {
       "type": "select",
       "id": "heading_size",
       "options": [
          { "value": "h2", "label": "Small" },
          { "value": "h1", "label": "Medium" },
          { "value": "h0", "label": "Large" }
       ],
       "default": "h2",
       "label": "Heading size"
    },
    {
       "type": "range",
       "id": "logo_opacity",
       "min": 0,
       "max": 100,
       "step": 10,
       "unit": "%",
       "label": "Logo opacity",
       "default": 50
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" },
        { "type": "logo" }
      ]
    }
  ]
}
{% endschema %}
