<div class="featured-blog section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading text-{{ section.settings.heading_alignment }}">
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- assign blog = section.settings.blog -%}

    <div class="blog__grid grid grid--1-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop">
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: section.settings.post_limit -%}
          <div class="grid__item" {{ block.shopify_attributes }}>
            <div class="article-card">
              <a href="{{ article.url }}" class="article-card__image media media--landscape">
                {%- if article.image != blank -%}
                  {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                {%- endif -%}
              </a>
              <div class="article-card__info">
                {%- if section.settings.show_date -%}
                  <span class="article-card__date">{{ article.published_at | date: "%B %d, %Y" }}</span>
                {%- endif -%}
                <h3 class="h3"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
                {%- if section.settings.show_excerpt -%}
                  <div class="article-card__excerpt rte">
                    {{ article.excerpt_or_content | strip_html | truncatewords: 30 }}
                  </div>
                {%- endif -%}
                <a href="{{ article.url }}" class="link">Read More</a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="grid__item">
            <div class="article-card">
              <div class="article-card__image media media--landscape placeholder">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
              <div class="article-card__info">
                <h3 class="h3">Blog Post Title</h3>
                <p>This is a placeholder for your blog post excerpt.</p>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{%- style -%}
  .article-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease;
  }
  .article-card:hover {
    transform: translateY(-0.5rem);
  }
  .article-card__info {
    padding: 2.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .article-card__date {
    font-size: 1.2rem;
    color: rgba(var(--color-base-text), 0.5);
    margin-bottom: 1rem;
    display: block;
    font-weight: 700;
  }
  .article-card__info h3 {
    margin: 0 0 1.5rem;
    line-height: 1.2;
    font-weight: 800;
  }
  .article-card__excerpt {
    margin-bottom: 2rem;
    font-size: 1.4rem;
    opacity: 0.8;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Featured blog",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Latest News",
      "label": "Heading"
    },
    {
       "type": "select",
       "id": "heading_size",
       "options": [
          { "value": "h2", "label": "Small" },
          { "value": "h1", "label": "Medium" },
          { "value": "h0", "label": "Large" }
       ],
       "default": "h1",
       "label": "Heading size"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Posts to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
       "type": "checkbox",
       "id": "show_date",
       "default": true,
       "label": "Show date"
    },
    {
       "type": "checkbox",
       "id": "show_excerpt",
       "default": true,
       "label": "Show excerpt"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Featured blog"
    }
  ]
}
{% endschema %}
