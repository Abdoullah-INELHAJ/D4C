<div class="image-with-text-columns section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading text-center">
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="grid grid--1-col grid--{{ section.settings.columns_desktop }}-col-desktop">
      {%- for block in section.blocks -%}
        <div class="grid__item" {{ block.shopify_attributes }}>
           <div class="column-card text-center">
              <div class="column-card__image media media--{% if section.settings.image_aspect == 'circle' %}circle{% else %}square{% endif %}">
                {%- if block.settings.image != blank -%}
                   {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy' }}
                {%- else -%}
                   {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="column-card__info">
                 <h3 class="h3">{{ block.settings.title | escape }}</h3>
                 <div class="rte">{{ block.settings.text }}</div>
                 {%- if block.settings.link_label != blank -%}
                    <a href="{{ block.settings.button_link }}" class="link">{{ block.settings.link_label | escape }}</a>
                 {%- endif -%}
              </div>
           </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .column-card {
    height: 100%;
    padding: 3rem;
  }
  .column-card__image {
    width: 20rem;
    margin: 0 auto 3rem;
    overflow: hidden;
  }
  .media--circle {
    border-radius: 50%;
  }
  .column-card__info h3 {
    font-weight: 800;
    margin-bottom: 2rem;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Image with text columns",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Our Highlights",
      "label": "Heading"
    },
    {
       "type": "select",
       "id": "heading_size",
       "options": [
          { "value": "h2", "label": "Small" },
          { "value": "h1", "label": "Medium" },
          { "value": "h0", "label": "Large" }
       ],
       "default": "h1",
       "label": "Heading size"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Number of columns on desktop"
    },
    {
      "type": "select",
      "id": "image_aspect",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "circle", "label": "Circle" }
      ],
      "default": "circle",
      "label": "Image shape"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Column",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Feature Name",
          "label": "Title"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Explain the benefit of this feature in detail.</p>",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with text columns",
      "blocks": [
        { "type": "column" },
        { "type": "column" },
        { "type": "column" }
      ]
    }
  ]
}
{% endschema %}
