<div class="contact-form section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading text-center">
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="contact__description rte text-center">
        {{ section.settings.description }}
      </div>
    {%- endif -%}

    <div class="contact-form__wrapper">
      {%- form 'contact', id: 'ContactForm', class: 'isolate' -%}
        {%- if form.posted_successfully? -%}
          <h2 class="form-status form-status-list form__message h3" tabindex="-1" autofocus>
            {% render 'icon-success' %}
            {{ 'templates.contact.form.post_success' | t | default: 'Your message has been sent successfully!' }}
          </h2>
        {%- elsif form.errors -%}
          <div class="form__message">
            <h2 class="form-status caption-large text-body h3" role="alert" tabindex="-1" autofocus>
              {% render 'icon-error' %}
              {{ 'templates.contact.form.error_heading' | t | default: 'Please adjust the error:' }}
            </h2>
          </div>
          <ul class="form-status-list caption-large h4" role="list">
             <li>
                <a href="#ContactForm-email" class="link">
                  {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
                </a>
             </li>
          </ul>
        {%- endif -%}

        <div class="contact__fields">
          <div class="field">
            <input class="field__input" autocomplete="name" type="text" id="ContactForm-name" name="contact[{{ 'templates.contact.form.name' | t | default: 'name' }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'templates.contact.form.name' | t | default: 'Name' }}">
            <label class="field__label visually-hidden" for="ContactForm-name">{{ 'templates.contact.form.name' | t | default: 'Name' }}</label>
          </div>
          <div class="field field--with-error">
            <input
              autocomplete="email"
              type="email"
              id="ContactForm-email"
              class="field__input"
              name="contact[email]"
              spellcheck="false"
              autocapitalize="off"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="ContactForm-email-error"
              {% endif %}
              placeholder="{{ 'templates.contact.form.email' | t | default: 'Email' }}"
              required
            >
            <label class="field__label visually-hidden" for="ContactForm-email">{{ 'templates.contact.form.email' | t | default: 'Email' }}</label>
          </div>
        </div>

        <div class="field">
          <input type="tel" id="ContactForm-phone" class="field__input" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t | default: 'phone' }}]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" placeholder="{{ 'templates.contact.form.phone' | t | default: 'Phone number' }}">
          <label class="field__label visually-hidden" for="ContactForm-phone">{{ 'templates.contact.form.phone' | t | default: 'Phone number' }}</label>
        </div>

        <div class="field">
          <textarea
            rows="10"
            id="ContactForm-body"
            class="text-area field__input"
            name="contact[{{ 'templates.contact.form.comment' | t | default: 'comment' }}]"
            placeholder="{{ 'templates.contact.form.comment' | t | default: 'Comment' }}"
            required
          >
            {{- form.body -}}
          </textarea>
          <label class="form__label field__label visually-hidden" for="ContactForm-body">{{ 'templates.contact.form.comment' | t | default: 'Comment' }}</label>
        </div>

        <div class="contact__button center">
          <button type="submit" class="button button--primary button--xl">
            {{ 'templates.contact.form.send' | t | default: 'Submit' }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{%- style -%}
  .contact-form__wrapper {
    max-width: 80rem;
    margin: 4rem auto 0;
  }
  .contact__fields {
     display: grid;
     grid-template-columns: repeat(2, 1fr);
     gap: 2rem;
     margin-bottom: 2rem;
  }
  .contact-form .field {
     margin-bottom: 2rem;
  }
  .contact-form .field__input {
     width: 100%;
     padding: 1.5rem 2rem;
     border: 1px solid rgba(var(--color-base-text), 0.1);
     background: white;
     border-radius: 8px;
  }
  .contact-form .text-area {
     height: 15rem;
  }
  .contact__description {
     margin-bottom: 2rem;
     font-size: 1.6rem;
     opacity: 0.8;
  }
  .button--xl {
     padding: 1.8rem 4rem;
     font-size: 1.6rem;
     text-transform: uppercase;
     font-weight: 800;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .contact__fields {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Get in touch",
      "label": "Heading"
    },
    {
       "type": "select",
       "id": "heading_size",
       "options": [
          { "value": "h2", "label": "Small" },
          { "value": "h1", "label": "Medium" },
          { "value": "h0", "label": "Large" }
       ],
       "default": "h1",
       "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
