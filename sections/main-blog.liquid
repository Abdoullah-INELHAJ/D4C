<div class="main-blog section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="blog-header center">
       <h1 class="h0">{{ blog.title }}</h1>
    </div>

    {%- paginate blog.articles by section.settings.posts_per_page -%}
       <div class="grid grid--1-col grid--{{ section.settings.columns_desktop }}-col-desktop">
          {%- for article in blog.articles -%}
             <div class="grid__item">
                <div class="article-card">
                   <a href="{{ article.url }}" class="article-card__image media media--landscape">
                      {%- if article.image != blank -%}
                         {{ article.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
                      {%- endif -%}
                   </a>
                   <div class="article-card__info">
                      <span class="article-card__date">{{ article.published_at | date: "%B %d, %Y" }}</span>
                      <h2 class="h3"><a href="{{ article.url }}">{{ article.title }}</a></h2>
                      <div class="article-card__excerpt rte">{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</div>
                      <a href="{{ article.url }}" class="link">Read More</a>
                   </div>
                </div>
             </div>
          {%- endfor -%}
       </div>

       {%- if paginate.pages > 1 -%}
          {% render 'pagination', paginate: paginate %}
       {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{%- style -%}
  .blog-header { margin-bottom: 5rem; }
  .article-card { background: white; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.05); height: 100%; display: flex; flex-direction: column; }
  .article-card__info { padding: 3rem; flex: 1; }
  .article-card__date { font-size: 1.2rem; color: rgba(var(--color-base-text), 0.5); font-weight: 700; margin-bottom: 1rem; display: block; }
  .article-card__info h2 { margin-bottom: 1.5rem; font-weight: 800; }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Main blog",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "posts_per_page",
      "min": 3,
      "max": 18,
      "step": 3,
      "default": 9,
      "label": "Posts per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 3,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ]
}
{% endschema %}
