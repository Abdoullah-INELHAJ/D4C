<div class="horizontal-ticker section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient" data-ticker>
  <div class="ticker__wrapper" style="--speed: {{ section.settings.speed }}s;">
    <div class="ticker__item-list">
      {%- for i in (1..10) -%}
        {%- for block in section.blocks -%}
          <div class="ticker__item h3" {{ block.shopify_attributes }}>
            {{ block.settings.text | escape }}
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .horizontal-ticker {
    overflow: hidden;
    background-color: var(--color-background);
    padding: 2.5rem 0;
    border-top: 1px solid rgba(var(--color-base-text), 0.1);
    border-bottom: 1px solid rgba(var(--color-base-text), 0.1);
  }
  .ticker__wrapper {
    display: flex;
    width: 200%;
    animation: ticker var(--speed) linear infinite;
  }
  .ticker__item-list {
    display: flex;
    gap: 4rem;
    white-space: nowrap;
    padding-left: 2rem;
  }
  .ticker__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
  }
  @keyframes ticker {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Horizontal ticker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 5,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Animation speed",
      "default": 30
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Ticker text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "Premium Shopify Theme • D4C Premium • Conversion Focused",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Horizontal ticker",
      "blocks": [
        { "type": "text" }
      ]
    }
  ]
}
{% endschema %}
