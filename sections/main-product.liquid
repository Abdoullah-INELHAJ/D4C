<section class="section-{{ section.id }}-padding">
  {{ 'product.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

  <div class="page-width">
    <div class="product grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper">
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if section.settings.enable_sticky_info %} product__info-wrapper--sticky{% endif %}">
        <div id="ProductInfo-{{ section.id }}" class="product__info-container">
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
              {%- when 'title' -%}
                <div class="product__title" {{ block.shopify_attributes }}>
                  <h1 class="h1">{{ product.title | escape }}</h1>
                </div>
              {%- when 'price' -%}
                <div class="no-js-hidden" id="price-{{ section.id }}" role="status" {{ block.shopify_attributes }}>
                  {%- render 'price', product: product, use_variant: true, show_badges: true, price_class: 'price--large' -%}
                </div>
              {%- when 'variant_picker' -%}
                {%- unless product.has_only_default_variant -%}
                  <variant-radios class="no-js-hidden" data-section="{{ section.id }}" data-url="{{ product.url }}" {{ block.shopify_attributes }}>
                    {%- for option in product.options_with_values -%}
                        <fieldset class="js product-form__input">
                          <legend class="form__label">{{ option.name }}</legend>
                          {%- for value in option.values -%}
                            <input type="radio" id="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}"
                                  name="{{ option.name }}"
                                  value="{{ value | escape }}"
                                  form="{{ product_form_id }}"
                                  {% if option.selected_value == value %}checked{% endif %}
                            >
                            <label for="{{ section.id }}-{{ option.position }}-{{ forloop.index0 }}">
                              {{ value }}
                            </label>
                          {%- endfor -%}
                        </fieldset>
                    {%- endfor -%}
                    <script type="application/json">
                      {{ product.variants | json }}
                    </script>
                  </variant-radios>
                {%- endunless -%}
              {%- when 'buy_buttons' -%}
                <div {{ block.shopify_attributes }}>
                  <product-form class="product-form">
                    {%- form 'product', product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" disabled>
                      <div class="product-form__buttons">
                        <button
                          type="submit"
                          name="add"
                          class="product-form__submit button button--full-width {% if block.settings.show_dynamic_checkout %}button--secondary{% else %}button--primary{% endif %}"
                        {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}
                        >
                            <span>
                              {%- if product.selected_or_first_available_variant.available -%}
                                {{ 'products.product.add_to_cart' | t }}
                              {%- else -%}
                                {{ 'products.product.sold_out' | t }}
                              {%- endif -%}
                            </span>
                        </button>
                        {%- if block.settings.show_dynamic_checkout -%}
                          {{ form | payment_button }}
                        {%- endif -%}
                      </div>
                    {%- endform -%}
                  </product-form>
                </div>
              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}
              {%- when 'text' -%}
                <p class="product__text {{ block.settings.text_style }}" {{ block.shopify_attributes }}>
                  {{ block.settings.text }}
                </p>
              {%- when 'urgency_text' -%}
                <div class="product__urgency" style="color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
                  {% render 'icon-flash' %} {{ block.settings.text | replace: '[stock]', product.selected_or_first_available_variant.inventory_quantity }}
                </div>
              {%- when 'inventory_status' -%}
                <div class="product__inventory" {{ block.shopify_attributes }}>
                  {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                      <span class="status-in-stock">{{ 'products.product.inventory_in_stock' | t | default: 'In Stock' }}</span>
                    {%- else -%}
                      <span class="status-out-of-stock">{{ 'products.product.inventory_out_of_stock' | t | default: 'Out of Stock' }}</span>
                    {%- endif -%}
                  {%- endif -%}
                </div>
              {%- when 'shipping_checkpoints' -%}
                {% render 'shipping-checkpoints', block: block %}
              {%- when 'countdown_timer' -%}
                {% render 'countdown-timer', block: block %}
              {%- when 'collapsable_row' -%}
                <details class="product__accordion" {{ block.shopify_attributes }}>
                  <summary class="h4">{{ block.settings.heading | escape }}</summary>
                  <div class="product__accordion-content rte">
                    {{ block.settings.content }}
                    {{ block.settings.page.content }}
                  </div>
                </details>
              {%- when 'icons_with_text' -%}
                <div class="product__icons-with-text" {{ block.shopify_attributes }}>
                  <div class="icon-with-text-item">
                    <span class="icon">{{ block.settings.icon_1 }}</span>
                    <span>{{ block.settings.text_1 }}</span>
                  </div>
                </div>
              {%- when 'product_upsells' -%}
                <div class="product__upsells" {{ block.shopify_attributes }}>
                  <h4>{{ block.settings.heading }}</h4>
                  {%- if block.settings.product_1 != blank -%}
                    <div class="upsell-item">
                      <img src="{{ block.settings.product_1.featured_image | image_url: width: 100 }}" alt="">
                      <div class="upsell-item__info">
                        <p>{{ block.settings.product_1.title }}</p>
                        <p>{{ block.settings.product_1.price | money }}</p>
                      </div>
                      <button class="button button--secondary button--small">Add</button>
                    </div>
                  {%- endif -%}
                </div>
              {%- when 'sticky_atc' -%}
                <div class="product__sticky-atc no-js-hidden" data-sticky-atc {{ block.shopify_attributes }}>
                  <div class="page-width">
                     <div class="sticky-atc__content">
                        <img src="{{ product.featured_image | image_url: width: 50 }}" alt="">
                        <div class="sticky-atc__info">
                          <p class="h4">{{ product.title }}</p>
                          <p>{{ product.selected_or_first_available_variant.price | money }}</p>
                        </div>
                        <button class="button" onclick="document.querySelector('#product-form-{{ section.id }}').submit()">Add to Cart</button>
                     </div>
                  </div>
                </div>
              {%- when 'payment_badges' -%}
                <div class="product__payment-badges" {{ block.shopify_attributes }}>
                   <ul class="list-payment" role="list">
                      {%- for type in shop.enabled_payment_types -%}
                        <li class="list-payment__item">
                          {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                        </li>
                      {%- endfor -%}
                    </ul>
                </div>
              {%- when 'share' -%}
                <div class="product__share" {{ block.shopify_attributes }}>
                  <button class="share-button">Share</button>
                </div>
              {%- when 'rating_stars' -%}
                <div class="product__rating" {{ block.shopify_attributes }}>
                  <span class="stars">★★★★★</span>
                </div>
              {%- when 'custom_product_field' -%}
                <div class="product__custom-field" {{ block.shopify_attributes }}>
                  <label for="CustomField-{{ section.id }}">{{ block.settings.label }}</label>
                  <input type="text" id="CustomField-{{ section.id }}" name="properties[{{ block.settings.label }}]" form="{{ product_form_id }}">
                </div>
              {%- when 'sizing_chart' -%}
                <div class="product__sizing-chart" {{ block.shopify_attributes }}>
                  <button class="link">View Sizing Chart</button>
                </div>
              {%- when 'gifts_on_quantity' -%}
                <div class="product__gifts" {{ block.shopify_attributes }}>
                  <p>Buy {{ block.settings.quantity }} items and get a <strong>{{ block.settings.gift_name }}</strong> for free!</p>
                </div>
              {%- when 'bundle_offer' -%}
                <div class="product__bundle" {{ block.shopify_attributes }}>
                  <p>Special Bundle: Add <strong>{{ block.settings.product_bundle.title }}</strong> and save!</p>
                </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_info",
      "default": true,
      "label": "Enable sticky info on desktop"
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "thumbnail", "label": "Thumbnail" },
        { "value": "thumbnail_slider", "label": "Thumbnail slider" }
      ],
      "default": "stacked",
      "label": "Gallery layout"
    }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "options": [
            { "value": "dropdown", "label": "Dropdown" },
            { "value": "button", "label": "Pills" }
          ],
          "default": "button",
          "label": "Picker type"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "default": true,
          "label": "Show dynamic checkout buttons"
        }
      ]
    },
    {
        "type": "product_upsells",
        "name": "Product upsells",
        "settings": [
            { "type": "product", "id": "product_1", "label": "Product 1" },
            { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently bought together" }
        ]
    },
    {
        "type": "sticky_atc",
        "name": "Sticky ATC",
        "limit": 1
    },
    {
        "type": "payment_badges",
        "name": "Payment badges",
        "limit": 1
    },
    {
        "type": "share",
        "name": "Share",
        "limit": 1
    },
    {
        "type": "rating_stars",
        "name": "Rating stars",
        "limit": 1
    },
    {
        "type": "image",
        "name": "Image",
        "settings": [
            { "type": "image_picker", "id": "image", "label": "Image" }
        ]
    },
    {
        "type": "custom_product_field",
        "name": "Custom product field",
        "settings": [
            { "type": "text", "id": "label", "label": "Label", "default": "Engraving" }
        ]
    },
    {
        "type": "sizing_chart",
        "name": "Sizing chart",
        "settings": [
            { "type": "page", "id": "page", "label": "Sizing chart page" }
        ]
    },
    {
        "type": "gifts_on_quantity",
        "name": "Gifts on quantity",
        "settings": [
            { "type": "number", "id": "quantity", "label": "Quantity needed", "default": 3 },
            { "type": "text", "id": "gift_name", "label": "Gift name", "default": "Free Pouch" }
        ]
    },
    {
        "type": "bundle_offer",
        "name": "Bundle offer",
        "settings": [
            { "type": "product", "id": "product_bundle", "label": "Select bundle product" }
        ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    },
    {
      "type": "urgency_text",
      "name": "Urgency text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Only [stock] left in stock!"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Text color",
          "default": "#ff0000"
        }
      ]
    },
    {
      "type": "inventory_status",
      "name": "Inventory status",
      "limit": 1
    },
    {
      "type": "complimentary_products",
      "name": "Complimentary products",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Pairs well with",
          "label": "Heading"
        }
      ]
    },
    {
        "type": "icons_with_text",
        "name": "Icons with text",
        "settings": [
            { "type": "text", "id": "text_1", "label": "Text 1", "default": "Free shipping" },
            { "type": "text", "id": "icon_1", "label": "Icon 1 (SVG)", "default": "truck" }
        ]
    },
    {
        "type": "collapsable_row",
        "name": "Collapsable row",
        "settings": [
            { "type": "text", "id": "heading", "label": "Heading", "default": "Collapsable row" },
            { "type": "richtext", "id": "content", "label": "Content" },
            { "type": "page", "id": "page", "label": "Row content from page" }
        ]
    },
    {
        "type": "shipping_checkpoints",
        "name": "Shipping checkpoints",
        "limit": 1
    },
    {
        "type": "countdown_timer",
        "name": "Countdown timer",
        "settings": [
            { "type": "text", "id": "end_date", "label": "End date (YYYY-MM-DD)", "default": "2024-12-31" },
            { "type": "text", "id": "text", "label": "Text", "default": "Offer ends in:" }
        ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Text block"
        },
        {
          "type": "select",
          "id": "text_style",
          "options": [
            { "value": "body", "label": "Body" },
            { "value": "subtitle", "label": "Subtitle" },
            { "value": "uppercase", "label": "Uppercase" }
          ],
          "default": "body",
          "label": "Text style"
        }
      ]
    }
  ]
}
{% endschema %}
