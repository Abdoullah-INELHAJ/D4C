{%- if section.settings.show_announcement -%}
  <div class="announcement-bar announcement-bar--{{ section.id }} color-{{ section.settings.color_scheme }}" role="region" aria-label="Announcement">
    <div class="page-width">
      <div class="announcement-bar__content">
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="announcement-bar__link link--text focus-inset">
        {%- endif -%}
          <p class="announcement-bar__message h6">
            {{ section.settings.text | escape }}
          </p>
        {%- if section.settings.link != blank -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- style -%}
    .announcement-bar--{{ section.id }} {
      background-color: {{ section.settings.bg_color }};
      color: {{ section.settings.text_color }};
      padding: 1rem 0;
      text-align: center;
      position: relative;
      z-index: 10;
    }

    .announcement-bar__message {
      margin: 0;
      font-size: 1.3rem;
      letter-spacing: 0.1rem;
      font-weight: 600;
      text-transform: uppercase;
    }

    .announcement-bar__link {
      color: inherit;
      text-decoration: none;
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Announcement text",
      "default": "Welcome to our store!"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Announcement link"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    }
  ]
}
{% endschema %}
