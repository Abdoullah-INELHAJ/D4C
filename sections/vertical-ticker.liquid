<div class="vertical-ticker section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="ticker-vertical__container">
      <div class="ticker-vertical__track" style="--speed: {{ section.settings.speed }}s;">
        {%- for i in (1..10) -%}
          {%- for block in section.blocks -%}
            <div class="ticker-vertical__item h1" {{ block.shopify_attributes }}>
              {{ block.settings.text | escape }}
            </div>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .vertical-ticker {
    background-color: var(--color-background);
    overflow: hidden;
    height: 30rem;
    display: flex;
    align-items: center;
  }
  .ticker-vertical__container {
    height: 100%;
    position: relative;
  }
  .ticker-vertical__track {
    display: flex;
    flex-direction: column;
    animation: tickerVertical var(--speed) linear infinite;
  }
  .ticker-vertical__item {
    height: 10rem;
    display: flex;
    align-items: center;
    justify-content: center;
    text-transform: uppercase;
    font-weight: 900;
    font-style: italic;
    letter-spacing: -0.2rem;
    color: transparent;
    -webkit-text-stroke: 1px rgb(var(--color-base-text));
    transition: all 0.3s ease;
    opacity: 0.2;
  }
  .ticker-vertical__item:nth-child(even) {
    color: rgb(var(--color-base-accent-1));
    -webkit-text-stroke: 0;
    opacity: 1;
  }

  @keyframes tickerVertical {
    0% { transform: translateY(0); }
    100% { transform: translateY(-50%); }
  }

  /* Duplicated track for seamless loop handled by Liquid (x10) */

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Vertical ticker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
       "type": "range",
       "id": "speed",
       "min": 5,
       "max": 60,
       "step": 1,
       "unit": "s",
       "label": "Animation speed",
       "default": 10
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Ticker text",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "default": "D4C Premium Theme",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Vertical ticker",
      "blocks": [
        { "type": "text", "settings": { "text": "Limited Edition" } },
        { "type": "text", "settings": { "text": "Unmatched Quality" } },
        { "type": "text", "settings": { "text": "Shop the Future" } }
      ]
    }
  ]
}
{% endschema %}
