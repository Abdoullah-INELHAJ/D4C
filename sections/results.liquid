<div class="results section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="results__grid grid grid--1-col grid--{{ section.settings.columns_desktop }}-col-desktop">
      {%- for block in section.blocks -%}
        <div class="grid__item results__item" {{ block.shopify_attributes }}>
          <div class="results__content text-center">
            <h2 class="results__number h0" data-target="{{ block.settings.number }}">
              {{ block.settings.prefix }}{{ block.settings.number }}{{ block.settings.suffix }}
            </h2>
            {%- if block.settings.label != blank -%}
              <p class="results__label h3">{{ block.settings.label | escape }}</p>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <div class="results__subtext rte">{{ block.settings.subtext }}</div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .results {
    background-color: var(--color-background);
  }
  .results__number {
    font-size: 8rem;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 1.5rem;
    color: rgb(var(--color-base-accent-1));
    letter-spacing: -0.2rem;
  }
  .results__label {
    text-transform: uppercase;
    letter-spacing: 0.15rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .results__subtext {
    font-size: 1.5rem;
    opacity: 0.7;
    max-width: 25rem;
    margin: 0 auto;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  @media screen and (max-width: 749px) {
    .results__number {
      font-size: 5rem;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Results (Stats)",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
       "type": "range",
       "id": "columns_desktop",
       "min": 2,
       "max": 4,
       "step": 1,
       "default": 4,
       "label": "Number of columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "result",
      "name": "Stat item",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "default": "100",
          "label": "Number"
        },
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix",
          "default": ""
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Customers",
          "label": "Label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Trust our premium solutions.</p>",
          "label": "Subtext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Results (Stats)",
      "blocks": [
        { "type": "result", "settings": { "number": "10", "suffix": "k+", "label": "Customers" } },
        { "type": "result", "settings": { "number": "99", "suffix": "%", "label": "Satisfaction" } },
        { "type": "result", "settings": { "number": "24", "suffix": "h", "label": "Response time" } },
        { "type": "result", "settings": { "number": "5", "suffix": "★", "label": "Review Score" } }
      ]
    }
  ]
}
{% endschema %}
