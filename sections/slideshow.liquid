<div class="slideshow section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="slideshow__inner swiper">
      <div class="swiper-wrapper">
        {%- for block in section.blocks -%}
          <div class="slideshow__slide swiper-slide" {{ block.shopify_attributes }}>
            <div class="slideshow__media media">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 3840 | image_tag:
                  loading: 'lazy',
                  widths: '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                  alt: block.settings.image.alt | escape
                }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
              {%- endif -%}
            </div>
            <div class="slideshow__content slideshow__content--{{ block.settings.box_align }} page-width">
               <div class="slideshow__box content-container content-container--full-width-mobile color-{{ section.settings.color_scheme }} gradient">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="slideshow__heading h1">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}
                  {%- if block.settings.subheading != blank -%}
                    <div class="slideshow__text rte">{{ block.settings.subheading }}</div>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <a {% if block.settings.link == blank %} role="link" aria-disabled="true" {% else %} href="{{ block.settings.link }}" {% endif %} class="button">
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- endif -%}
               </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
      
      <div class="swiper-pagination"></div>
      <div class="swiper-button-prev"></div>
      <div class="swiper-button-next"></div>
    </div>
  </div>
</div>

{%- style -%}
  .slideshow {
    overflow: hidden;
  }
  .slideshow__slide {
    height: 60rem;
    position: relative;
    display: flex;
    align-items: center;
  }
  .slideshow__media {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .slideshow__content {
    z-index: 1;
    display: flex;
    min-height: inherit;
    width: 100%;
    height: 100%;
  }
  .slideshow__content--center { justify-content: center; align-items: center; text-align: center; }
  .slideshow__content--left { justify-content: flex-start; align-items: center; text-align: left; }
  .slideshow__content--right { justify-content: flex-end; align-items: center; text-align: right; }

  .slideshow__box {
    padding: 4rem;
    background-color: var(--color-background);
    max-width: 50rem;
    border-radius: var(--buttons-radius);
  }
  .slideshow__heading {
    margin-bottom: 2rem;
    font-weight: 800;
  }
  .slideshow__text {
    font-size: 1.8rem;
    margin-bottom: 3rem;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Slideshow heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "default": "<p>Introduce your brand with a stunning slideshow.</p>",
          "label": "Subheading"
        },
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "box_align",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center",
          "label": "Box alignment"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
