<div class="shipping-info-bar section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="shipping-info__grid grid grid--1-col grid--{{ section.settings.columns_desktop }}-col-desktop">
      {%- for block in section.blocks -%}
        <div class="grid__item shipping-info__item" {{ block.shopify_attributes }}>
           <div class="shipping-info__content">
              <div class="shipping-info__icon">
                 {%- case block.settings.icon -%}
                    {%- when 'truck' -%}
                       {% render 'icon-truck' %}
                    {%- when 'heart' -%}
                       {% render 'icon-heart' %}
                    {%- when 'shield' -%}
                       {% render 'icon-shield' %}
                    {%- when 'return' -%}
                       {% render 'icon-return' %}
                    {%- when 'star' -%}
                       {% render 'icon-star' %}
                 {%- endcase -%}
              </div>
              <div class="shipping-info__text">
                 <h4 class="h4">{{ block.settings.heading | escape }}</h4>
                 <p>{{ block.settings.subtext | escape }}</p>
              </div>
           </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .shipping-info-bar {
    background-color: var(--color-background);
    border-top: 1px solid rgba(var(--color-base-text), 0.1);
    border-bottom: 1px solid rgba(var(--color-base-text), 0.1);
  }
  .shipping-info__grid {
    gap: 3rem;
  }
  .shipping-info__item {
    padding: 1rem 0;
  }
  .shipping-info__content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    justify-content: center;
  }
  .shipping-info__icon {
    width: 3.5rem;
    height: 3.5rem;
    color: rgb(var(--color-base-accent-1));
    flex-shrink: 0;
  }
  .shipping-info__icon svg {
    width: 100%;
    height: 100%;
  }
  .shipping-info__text h4 { margin: 0; font-weight: 800; font-size: 1.4rem; text-transform: uppercase; letter-spacing: 0.1rem; }
  .shipping-info__text p { margin: 0.5rem 0 0; font-size: 1.2rem; font-weight: 600; opacity: 0.7; }

  @media screen and (max-width: 749px) {
    .shipping-info__content { justify-content: flex-start; }
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Shipping info bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
       "type": "range",
       "id": "columns_desktop",
       "min": 2,
       "max": 4,
       "step": 1,
       "default": 4,
       "label": "Number of columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "info",
      "name": "Info item",
      "settings": [
        {
           "type": "select",
           "id": "icon",
           "options": [
              { "value": "truck", "label": "Truck" },
              { "value": "heart", "label": "Heart" },
              { "value": "shield", "label": "Shield" },
              { "value": "return", "label": "Return" },
              { "value": "star", "label": "Star" }
           ],
           "default": "truck",
           "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Free Shipping",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "default": "On orders over $50",
          "label": "Subtext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shipping info bar",
      "blocks": [
        { "type": "info", "settings": { "icon": "truck", "heading": "Free Shipping" } },
        { "type": "info", "settings": { "icon": "return", "heading": "30 Days Return" } },
        { "type": "info", "settings": { "icon": "shield", "heading": "Secure Payment" } },
        { "type": "info", "settings": { "icon": "heart", "heading": "Made with Love" } }
      ]
    }
  ]
}
{% endschema %}
