<div class="icon-bar section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="icon-bar__grid grid grid--1-col grid--{{ section.settings.columns_desktop }}-col-desktop">
      {%- for block in section.blocks -%}
        <div class="grid__item icon-bar__item" {{ block.shopify_attributes }}>
          <div class="icon-bar__content">
            {%- if block.settings.icon_type == 'svg' -%}
                <div class="icon-bar__icon icon-bar__icon--svg">{{ block.settings.icon_svg }}</div>
            {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 100 | image_tag: loading: 'lazy', class: 'icon-bar__icon' }}
            {%- else -%}
                <div class="icon-bar__icon icon-bar__icon--default">{% render 'icon-checkmark' %}</div>
            {%- endif -%}
            
            <div class="icon-bar__text">
              {%- if block.settings.title != blank -%}
                <h3 class="h4">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <p class="icon-bar__subtext">{{ block.settings.subtext | escape }}</p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- style -%}
  .icon-bar {
    background-color: var(--color-background);
    border-top: 1px solid rgba(var(--color-base-text), 0.1);
    border-bottom: 1px solid rgba(var(--color-base-text), 0.1);
  }
  .icon-bar__item {
    padding: 2rem;
  }
  .icon-bar__content {
    display: flex;
    align-items: center;
    gap: 2rem;
    justify-content: center;
  }
  .icon-bar__icon {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgb(var(--color-base-accent-1));
  }
  .icon-bar__icon svg {
    width: 100%;
    height: auto;
  }
  .icon-bar__text {
    text-align: left;
  }
  .icon-bar__text h3 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
  }
  .icon-bar__subtext {
    margin: 0.5rem 0 0;
    font-size: 1.3rem;
    opacity: 0.7;
    font-weight: 600;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Icon bar",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
       "type": "range",
       "id": "columns_desktop",
       "min": 2,
       "max": 4,
       "step": 1,
       "default": 4,
       "label": "Number of columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "icon_item",
      "name": "Icon item",
      "settings": [
        {
          "type": "select",
          "id": "icon_type",
          "options": [
            { "value": "svg", "label": "SVG Code" },
            { "value": "image", "label": "Image" },
            { "value": "default", "label": "Default Checkmark" }
          ],
          "default": "default",
          "label": "Icon type"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "SVG Icon code"
        },
        {
           "type": "image_picker",
           "id": "image",
           "label": "Icon image"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Free Shipping",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "default": "On orders over $50",
          "label": "Subtext"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon bar",
      "blocks": [
        { "type": "icon_item", "settings": { "title": "Free Shipping", "subtext": "Fast & Secure" } },
        { "type": "icon_item", "settings": { "title": "24/7 Support", "subtext": "We are here for you" } },
        { "type": "icon_item", "settings": { "title": "Money Back", "con_type": "default", "subtext": "30 days guarantee" } },
        { "type": "icon_item", "settings": { "title": "Premium Quality", "subtext": "Certified products" } }
      ]
    }
  ]
}
{% endschema %}
