<div class="scrolling-collection section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading text-center">
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="scrolling-collection__inner swiper" data-swiper-scrolling-collection>
      <div class="swiper-wrapper">
        {%- for collection in section.settings.collection_list -%}
          <div class="swiper-slide scrolling-collection__slide">
            <a href="{{ collection.url }}" class="scrolling-collection__card">
              <div class="scrolling-collection__image media media--circle">
                {%- if collection.featured_image != blank -%}
                  {{ collection.featured_image | image_url: width: 400 | image_tag: loading: 'lazy' }}
                {%- else -%}
                   {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              <div class="scrolling-collection__info center">
                <h3 class="h4">{{ collection.title | escape }}</h3>
              </div>
            </a>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .scrolling-collection {
    overflow: hidden;
  }
  .scrolling-collection__inner {
    padding: 2rem 0;
  }
  .scrolling-collection__slide {
    width: auto !important;
    padding: 0 1.5rem;
  }
  .scrolling-collection__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease;
  }
  .scrolling-collection__card:hover {
    transform: translateY(-0.5rem);
  }
  .scrolling-collection__image {
    width: 12rem;
    height: 12rem;
    border-radius: 50%;
    overflow: hidden;
    background: #f5f5f5;
  }
  .scrolling-collection__info h3 {
    margin: 0;
    font-weight: 700;
    font-size: 1.4rem;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<script>
  function initScrollingCollection() {
    const swiperEl = document.querySelector('[data-swiper-scrolling-collection]');
    if (!swiperEl) return;
    
    new Swiper(swiperEl, {
      slidesPerView: 'auto',
      spaceBetween: 0,
      freeMode: true,
      grabCursor: true,
    });
  }
  document.addEventListener('DOMContentLoaded', initScrollingCollection);
  if (Shopify.designMode) {
    document.addEventListener('shopify:section:load', initScrollingCollection);
  }
</script>

{% schema %}
{
  "name": "Scrolling collection",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Shop by category",
      "label": "Heading"
    },
    {
       "type": "select",
       "id": "heading_size",
       "options": [
          { "value": "h2", "label": "Small" },
          { "value": "h1", "label": "Medium" },
          { "value": "h0", "label": "Large" }
       ],
       "default": "h2",
       "label": "Heading size"
    },
    {
       "type": "collection_list",
       "id": "collection_list",
       "label": "Collections"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Scrolling collection"
    }
  ]
}
{% endschema %}
