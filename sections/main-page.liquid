<div class="main-page section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow">
    <div class="page-header center">
       <h1 class="h0">{{ page.title | escape }}</h1>
    </div>
    <div class="page-content rte">
       {{ page.content }}
    </div>
  </div>
</div>

{%- style -%}
  .page-header { margin-bottom: 5rem; }
  .page-content { font-size: 1.8rem; line-height: 1.8; }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Main page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ]
}
{% endschema %}
