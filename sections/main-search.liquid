<div class="main-search section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="search-header center">
       <h1 class="h0">{{ 'general.search.title' | t | default: 'Search Results' }}</h1>
       <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
          <input
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t | default: 'Search...' }}"
            class="search__input"
          >
          <button type="submit" class="button button--primary">{{ 'general.search.submit' | t | default: 'Search' }}</button>
       </form>
    </div>

    {%- if search.performed -%}
       {%- paginate search.results by 24 -%}
          {%- if search.results_count > 0 -%}
             <div class="grid grid--2-col grid--4-col-desktop">
                {%- for item in search.results -%}
                   <div class="grid__item">
                      {%- case item.object_type -%}
                         {%- when 'product' -%}
                            {% render 'product-card', product: item %}
                         {%- when 'article' -%}
                            <div class="article-card article-card--small">
                               <a href="{{ item.url }}" class="article-card__image media media--square">
                                  {%- if item.image -%}
                                     {{ item.image | image_url: width: 300 | image_tag: loading: 'lazy' }}
                                  {%- endif -%}
                               </a>
                               <div class="article-card__info">
                                  <h3 class="h4"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                               </div>
                            </div>
                         {%- when 'page' -%}
                            <div class="page-card center">
                               <h3 class="h4"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                               <p class="link">View Page</p>
                            </div>
                      {%- endcase -%}
                   </div>
                {%- endfor -%}
             </div>
             {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
             {%- endif -%}
          {%- else -%}
             <div class="search__no-results center">
                <p>{{ 'general.search.no_results' | t: terms: search.terms | default: 'No results for your search' }}</p>
             </div>
          {%- endif -%}
       {%- endpaginate -%}
    {%- endif -%}
  </div>
</div>

{%- style -%}
  .search-header { margin-bottom: 5rem; }
  .search__form { display: flex; max-width: 60rem; margin: 3rem auto 0; gap: 1rem; }
  .search__input { flex: 1; padding: 1.5rem 2rem; border-radius: 8px; border: 1px solid rgba(var(--color-base-text), 0.1); }
  .article-card--small { border: 1px solid rgba(var(--color-base-text), 0.1); border-radius: 12px; overflow: hidden; height: 100%; transition: transform 0.3s ease; }
  .article-card--small:hover { transform: translateY(-0.5rem); }
  .article-card--small .article-card__info { padding: 1.5rem; text-align: center; }
  .page-card { padding: 4rem; background: rgba(var(--color-base-text), 0.03); border-radius: 12px; height: 100%; }
  .page-card h3 { margin-bottom: 1.5rem; font-weight: 800; }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ]
}
{% endschema %}
