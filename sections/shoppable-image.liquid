<div class="shoppable-image section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading text-center">
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="shoppable-image__container">
      <div class="shoppable-image__media">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'shoppable-image__img' }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          <div class="shoppable-point" style="top: {{ block.settings.top }}%; left: {{ block.settings.left }}%;" {{ block.shopify_attributes }}>
            <button class="shoppable-point__button" aria-label="View {{ product.title }}">
              <span class="shoppable-point__pulse"></span>
            </button>
            <div class="shoppable-point__card">
               {%- if product != blank -%}
                  <div class="point-product">
                    <img src="{{ product.featured_image | image_url: width: 150 }}" alt="{{ product.title }}">
                    <div class="point-product__info">
                      <p class="h4">{{ product.title }}</p>
                      <p>{{ product.price | money }}</p>
                      <a href="{{ product.url }}" class="link">View Product</a>
                    </div>
                  </div>
               {%- else -%}
                  <p>Select a product</p>
               {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .shoppable-image__container {
    position: relative;
    max-width: 120rem;
    margin: 0 auto;
    border-radius: 12px;
    overflow: hidden;
  }
  .shoppable-image__media {
    position: relative;
  }
  .shoppable-image__img {
    width: 100%;
    height: auto;
    display: block;
  }
  .shoppable-point {
    position: absolute;
    z-index: 2;
    transform: translate(-50%, -50%);
  }
  .shoppable-point__button {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: white;
    border: none;
    cursor: pointer;
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
    position: relative;
    z-index: 1;
  }
  .shoppable-point__pulse {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { width: 100%; height: 100%; opacity: 1; }
    100% { width: 300%; height: 300%; opacity: 0; }
  }
  .shoppable-point__card {
    position: absolute;
    bottom: calc(100% + 1rem);
    left: 50%;
    transform: translateX(-50%) translateY(1rem);
    width: 25rem;
    background: white;
    padding: 1.5rem;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
    z-index: 2;
  }
  .shoppable-point:hover .shoppable-point__card {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }
  .point-product {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }
  .point-product img {
    width: 6rem;
    height: 6rem;
    border-radius: 4px;
    object-fit: cover;
  }
  .point-product__info p { margin: 0; }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Shoppable image",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Shop the look",
      "label": "Heading"
    },
    {
       "type": "select",
       "id": "heading_size",
       "options": [
          { "value": "h2", "label": "Small" },
          { "value": "h1", "label": "Medium" },
          { "value": "h0", "label": "Large" }
       ],
       "default": "h1",
       "label": "Heading size"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "top",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Top position",
          "default": 50
        },
        {
          "type": "range",
          "id": "left",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Left position",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable image",
      "blocks": [
        { "type": "hotspot", "settings": { "top": 40, "left": 30 } },
        { "type": "hotspot", "settings": { "top": 60, "left": 70 } }
      ]
    }
  ]
}
{% endschema %}
