<div class="faq-with-image section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width">
    <div class="faq-grid grid grid--1-col grid--2-col-tablet">
      <div class="grid__item faq-image {% if section.settings.layout == 'image_second' %}order-last{% endif %}">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', class: 'faq-img' }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="grid__item faq-content">
        <h2 class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        <div class="faq-accordion">
          {%- for block in section.blocks -%}
            <details class="faq-item" {{ block.shopify_attributes }}>
              <summary class="h4">
                {{ block.settings.question | escape }}
                {% render 'icon-caret' %}
              </summary>
              <div class="faq-answer rte">
                {{ block.settings.answer }}
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{%- style -%}
  .faq-grid {
    align-items: center;
    gap: 4rem;
  }
  .faq-img {
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .faq-item {
    border-bottom: 1px solid rgba(var(--color-base-text), 0.1);
    padding: 2rem 0;
  }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    list-style: none;
    font-weight: 700;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary svg {
    transition: transform 0.3s ease;
    width: 1.5rem;
  }
  .faq-item details[open] summary svg {
    transform: rotate(180deg);
  }
  .faq-answer {
    margin-top: 2rem;
    font-size: 1.5rem;
    opacity: 0.8;
  }
  .order-last {
    order: 1;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "FAQ with image",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Frequently Asked Questions",
      "label": "Heading"
    },
    {
       "type": "select",
       "id": "heading_size",
       "options": [
          { "value": "h2", "label": "Small" },
          { "value": "h1", "label": "Medium" },
          { "value": "h0", "label": "Large" }
       ],
       "default": "h1",
       "label": "Heading size"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Section image"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "image_second", "label": "Image second" }
      ],
      "default": "image_first",
      "label": "Desktop layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
       "type": "header",
       "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "default": "What is the return policy?",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "default": "<p>We offer a 30-day money back guarantee.</p>",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ with image",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
