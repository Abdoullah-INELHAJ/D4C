<div class="product-card">
  <div class="product-card__media">
    <a href="{{ product.url | within: collection }}" class="product-card__link">
      <div class="media media--square">
        {{ product.featured_image | image_url: width: 600 | image_tag: 
          loading: 'lazy',
          widths: '200, 400, 600',
          alt: product.featured_image.alt | escape
        }}
        {%- if product.images[1] != blank -%}
          {{ product.images[1] | image_url: width: 600 | image_tag: 
            loading: 'lazy',
            class: 'product-card__secondary-image',
            widths: '200, 400, 600',
            alt: product.images[1].alt | escape
          }}
        {%- endif -%}
      </div>
    </a>

    {%- if product.compare_at_price > product.price -%}
      <span class="badge badge--sale">-{{ product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price }}%</span>
    {%- endif -%}

    {%- unless product.available -%}
      <span class="badge badge--sold-out">Sold Out</span>
    {%- endunless -%}
  </div>

  <div class="product-card__info">
    <h3 class="product-card__title h4">
      <a href="{{ product.url | within: collection }}">{{ product.title }}</a>
    </h3>
    <div class="product-card__price">
      {%- render 'price', product: product -%}
    </div>
  </div>
</div>

<style>
  .product-card {
    position: relative;
    transition: all 0.3s ease;
  }
  .product-card__media {
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background-color: #f5f5f5;
  }
  .product-card__secondary-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .product-card:hover .product-card__secondary-image {
    opacity: 1;
  }
  .media--square {
    padding-bottom: 100%;
  }
  .product-card__info {
    padding: 1.5rem 0;
  }
  .product-card__title {
    margin: 0 0 0.5rem;
    font-size: 1.6rem;
    font-weight: 700;
  }
  .badge--sale {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: #ff4d4d;
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
    font-size: 1.2rem;
    font-weight: 700;
  }
  .badge--sold-out {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background: #000;
    color: white;
    padding: 0.4rem 0.8rem;
    font-size: 1.2rem;
  }
</style>
