{%- liquid
  assign free_shipping_threshold = settings.free_shipping_threshold | times: 100
  assign cart_total = cart.total_price
  assign remaining = free_shipping_threshold | minus: cart_total
  assign percentage = cart_total | times: 100 | divided_by: free_shipping_threshold
  if percentage > 100
    assign percentage = 100
  endif
-%}

<div class="free-shipping-bar" data-threshold="{{ free_shipping_threshold }}">
  <div class="free-shipping-bar__text">
    {%- if cart_total < free_shipping_threshold -%}
      <p>{{ 'sections.cart.free_shipping_away_html' | t: amount: (remaining | money) | default: 'You are [amount] away from free shipping!' | replace: '[amount]', (remaining | money) }}</p>
    {%- else -%}
      <p>{{ 'sections.cart.free_shipping_reached' | t | default: 'You have unlocked free shipping! 🎉' }}</p>
    {%- endif -%}
  </div>
  <div class="free-shipping-bar__progress">
    <div class="free-shipping-bar__line" style="width: {{ percentage }}%;"></div>
  </div>
</div>
