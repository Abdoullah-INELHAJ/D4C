<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {{ content_for_header }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    {% style %}
      :root {
        --color-background: {{ settings.colors_background_1.red }}, {{ settings.colors_background_1.green }}, {{ settings.colors_background_1.blue }};
        --color-foreground: {{ settings.colors_text.red }}, {{ settings.colors_text.green }}, {{ settings.colors_text.blue }};
      }

      .password-page {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        text-align: center;
        padding: 2rem;
        background-color: rgb(var(--color-background));
        color: rgb(var(--color-foreground));
      }

      .password-header {
        margin-bottom: 4rem;
      }

      .password-main {
        max-width: 40rem;
        width: 100%;
      }

      .password-logo {
        max-width: {{ settings.logo_width }}px;
      }
    {% endstyle %}
  </head>

  <body class="password-page">
    <header class="password-header">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 500 | image_tag:
          loading: 'lazy',
          class: 'password-logo',
          widths: '50, 100, 150, 200, 250, 300, 400, 500',
          alt: shop.name
        }}
      {%- else -%}
        <h1 class="h2">{{ shop.name }}</h1>
      {%- endif -%}
    </header>

    <main id="MainContent" class="password-main">
      {{ content_for_layout }}
    </main>

    <footer class="password-footer">
      <small>&copy; {{ 'now' | date: "%Y" }}, {{ shop.name }}</small>
    </footer>

    <div id="PasswordModal" class="password-modal" style="display:none;">
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <div class="error">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label for="password">Password</label>
        <input type="password" name="password" id="password" autocomplete="current-password">
        <button type="submit" class="button">Enter</button>
      {%- endform -%}
    </div>
  </body>
</html>
